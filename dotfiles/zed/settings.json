{
  "language_models": {
    "openai_compatible": {
      "lmstudio-local": {
        "api_url": "http://127.0.0.1:1234/v1",
        "available_models": [
          {
            "name": "lmstudio-community/Qwen3-Coder-Next-GGUF/Qwen3-Coder-Next-Q4_K_M.gguf",
            "display_name": "Qwen3 Coder Next (LM Studio)",
            "max_tokens": 262144,
            "supports_tools": true
          },
        ],
      },
    },
  },
  // "edit_predictions": {
  //   "provider": "open_ai_compatible_api",
  //   "open_ai_compatible_api": {
  //     "api_url": "http://127.0.0.1:1234/v1/completions",
