  //     "max_output_tokens": 512,
  //   },
  // },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "lmstudio-local",
      "model": "lmstudio-community/Qwen3-Coder-Next-GGUF/Qwen3-Coder-Next-Q4_K_M.gguf",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "which_key": {
    "enabled": false,
  },
  "project_panel": {
    "dock": "left",
    "show_diagnostics": "all",
    "button": true,
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": false,
  },
  "show_whitespaces": "selection",
  "toolbar": {
    "agent_review": false,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": true,
  },
  "vim": {
    "toggle_relative_line_numbers": false,
  },
  "window_decorations": "client",
  "use_system_window_tabs": false,
  "centered_layout": {
    "right_padding": 0.2,
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": false,
    "enable_preview_multibuffer_from_code_navigation": false,
  },
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": false,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": false,
      "max_severity": null,
    },
    "button": true,
  },
  "base_keymap": "VSCode",
  "audio": {
    "experimental.input_audio_device": "__ZED_AUDIO_DEVICE__",
    "experimental.output_audio_device": "__ZED_AUDIO_DEVICE__",
  },
  "buffer_line_height": "standard",
  "buffer_font_weight": 400.0,
  "diff_view_style": "split",
  "terminal": {
    "button": false,
    "shell": "system",
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": false,
    "show": false,
  },
  "disable_ai": false,
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "theme": "Ayu Dark",
}
