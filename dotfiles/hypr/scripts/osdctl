#!/usr/bin/env bash

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
osd_state_dir="$runtime_dir/quickshell-osd"
osd_state_file="$osd_state_dir/state.json"
osd_timer_file="$osd_state_dir/hide.pid"

schedule_hide() {
    if [ -f "$osd_timer_file" ]; then
        old_pid=$(cat "$osd_timer_file" 2>/dev/null || true)
        if [ -n "${old_pid:-}" ]; then
            kill "$old_pid" >/dev/null 2>&1 || true
        fi
    fi

    (
        sleep 0.5
        write_state false "" "" 0
    ) &
    echo $! > "$osd_timer_file"
}

json_escape() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/ }
    printf '%s' "$value"
}

write_state() {
    local visible=$1
    local icon=$2
    local text=$3
    local value=$4

    mkdir -p "$osd_state_dir"
    printf '{"visible":%s,"icon":"%s","text":"%s","value":%s}\n' \
        "$visible" \
        "$(json_escape "$icon")" \
        "$(json_escape "$text")" \
        "$value" > "$osd_state_file"
}

render_osd() {
    local icon=$1
    local text=$2
    local value=$3

    write_state true "$icon" "$text" "$value"
    schedule_hide
}

get_volume_percent() {
    wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '
        /Volume:/ {
            value = int(($2 + 0) * 100 + 0.5)
        }
        /MUTED/ {
            muted = 1
        }
        END {
            if (value < 0) value = 0
            if (value > 100) value = 100
            print value "|" muted
        }'
}

get_mic_percent() {
    wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | awk '
        /Volume:/ {
            value = int(($2 + 0) * 100 + 0.5)
        }
        /MUTED/ {
            muted = 1
        }
        END {
            if (value < 0) value = 0
            if (value > 100) value = 100
            print value "|" muted
        }'
}

get_brightness_percent() {
    brightnessctl -m 2>/dev/null | awk -F, 'NR==1 { gsub(/%/, "", $4); print int($4 + 0) }'
}

handle_volume() {
    case "${1:-}" in
        up)
            wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ >/dev/null
            ;;
        down)
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- >/dev/null
            ;;
        mute)
            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null
            ;;
    esac

    local state value muted icon
    state=$(get_volume_percent)
    value=${state%%|*}
    muted=${state##*|}

    if [ "$muted" = "1" ] || [ "$value" -eq 0 ]; then
        icon="󰝟"
        render_osd "$icon" "Volume Muted" "$value"
        return
    fi

    if [ "$value" -lt 34 ]; then
        icon="󰕿"
    elif [ "$value" -lt 67 ]; then
        icon="󰖀"
    else
        icon="󰕾"
    fi

    render_osd "$icon" "Volume ${value}%" "$value"
}

handle_mic() {
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

    local state value muted icon
    state=$(get_mic_percent)
    value=${state%%|*}
    muted=${state##*|}

    if [ "$muted" = "1" ]; then
        icon="󰍭"
        render_osd "$icon" "Microphone Muted" "$value"
    else
        icon="󰍬"
        render_osd "$icon" "Microphone ${value}%" "$value"
    fi
}

handle_brightness() {
    case "${1:-}" in
        up)
            brightnessctl -e4 -n2 set 5%+ >/dev/null
            ;;
        down)
            brightnessctl -e4 -n2 set 5%- >/dev/null
            ;;
        set)
            local target=${2:-}
            if [[ ! "$target" =~ ^[0-9]+$ ]]; then
                echo "brightness-set requires a percentage from 0 to 100" >&2
                exit 1
            fi

            if [ "$target" -lt 0 ]; then
                target=0
            elif [ "$target" -gt 100 ]; then
                target=100
            fi

            brightnessctl -n2 set "${target}%" >/dev/null
            ;;
    esac

    local value
    value=$(get_brightness_percent)
    value=${value:-0}
    render_osd "󰃠" "Brightness ${value}%" "$value"
}

case "${1:-}" in
    volume-up)
        handle_volume up
        ;;
    volume-down)
        handle_volume down
        ;;
    volume-mute)
        handle_volume mute
        ;;
    mic-mute)
        handle_mic
        ;;
    brightness-up)
        handle_brightness up
        ;;
    brightness-down)
        handle_brightness down
        ;;
    brightness-set)
        handle_brightness set "${2:-}"
        ;;
    *)
        echo "usage: osdctl {volume-up|volume-down|volume-mute|mic-mute|brightness-up|brightness-down|brightness-set PERCENT}" >&2
        exit 1
        ;;
esac
