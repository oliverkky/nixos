#!/usr/bin/env sh

set -eu

echo "wallutils wayinfo:"
if command -v wayinfo >/dev/null 2>&1; then
    wayinfo || true
else
    echo "wayinfo not found" >&2
fi

echo
echo "wallutils lsmon:"
if command -v lsmon >/dev/null 2>&1; then
    lsmon -d || true
else
    echo "lsmon not found" >&2
fi

echo
echo "hyprctl monitors:"
if command -v hyprctl >/dev/null 2>&1; then
    hyprctl monitors || true
else
    echo "hyprctl not found" >&2
fi
