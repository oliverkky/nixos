#!/usr/bin/env bash

set -euo pipefail

monitor="${HYPR_PRIMARY_MONITOR:-}"

if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    exit 0
fi

if [[ -z "$monitor" ]]; then
    monitor="$(
        hyprctl -j monitors 2>/dev/null \
            | jq -r 'map(select(.focused == true))[0].name // .[0].name // empty'
    )"
fi

if [[ -z "$monitor" ]]; then
    exit 0
fi

profile="balanced"
if command -v powerprofilesctl >/dev/null 2>&1; then
    profile="$(powerprofilesctl get 2>/dev/null || printf balanced)"
fi

cap_brightness_for_power_saver() {
    if ! command -v brightnessctl >/dev/null 2>&1; then
        return
    fi

    local current
    current="$(
        brightnessctl -m 2>/dev/null \
            | awk -F, 'NR == 1 { gsub(/%/, "", $4); print int($4 + 0) }'
    )"

    if [[ -n "$current" && "$current" -gt 25 ]]; then
        brightnessctl set 25% >/dev/null
    fi
}

case "$profile" in
    power-saver)
        cap_brightness_for_power_saver
        refresh="60"
        ;;
    performance)
        refresh="90"
        ;;
    *)
        refresh="60"
        ;;
esac

active="$(
    hyprctl -j monitors 2>/dev/null \
        | jq -r --arg name "$monitor" '
            map(select(.name == $name))[0]
            | if . == null then empty else "\(.x) \(.y) \(.scale) \(.width)x\(.height)" end
        '
)"

if [[ -z "$active" ]]; then
    exit 0
fi

read -r x y scale resolution <<<"$active"

mode="$(
    hyprctl -j monitors all 2>/dev/null \
        | jq -r --arg name "$monitor" --arg refresh "$refresh" --arg resolution "$resolution" '
            map(select(.name == $name))[0].availableModes // []
            | (
                map(select(startswith($resolution + "@") and test("@" + $refresh + "(\\.[0-9]+)?Hz$")))[0]
                // map(select(test("@" + $refresh + "(\\.[0-9]+)?Hz$")))[0]
                // empty
            )
        '
)"

if [[ -z "$mode" ]]; then
    mode="${resolution}@${refresh}"
fi

lua_config="hl.monitor({ output = \"$monitor\", mode = \"$mode\", position = \"${x}x${y}\", scale = $scale })"

if hyprctl eval "$lua_config"; then
    exit 0
fi

printf 'hyprctl eval failed, trying legacy monitor keyword\n' >&2
hyprctl keyword monitor "${monitor},${mode},${x}x${y},${scale}"
