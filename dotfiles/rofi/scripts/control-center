#!/usr/bin/env bash

set -euo pipefail

config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
script_dir="${ROFI_SCRIPT_DIR:-$config_root/rofi/scripts}"
source "$script_dir/control-lib"

choice=$(
    {
        printf '󰤨  Network\n'
        printf '󰂯  Bluetooth\n'
        printf '󰕾  Audio\n'
        printf '󰃠  Brightness\n'
        printf '  Screenshot\n'
        printf '  Power\n'
    } | rofi_menu "Control" "$(hostname)" 6 1
)

case "$choice" in
    *Network) "$script_dir/control-network" ;;
    *Bluetooth) "$script_dir/control-bluetooth" ;;
    *Audio) "$script_dir/control-audio" ;;
    *Brightness) "$script_dir/control-brightness" ;;
    *Screenshot) "$script_dir/control-screenshot" ;;
    *Power) "$script_dir/control-session" ;;
esac
