{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "reload_style_on_change": true,

  "include": [
    "./modules/groups.jsonc",
    "./modules/launchers.jsonc",
    "./modules/storage.jsonc",
    "./modules/system.jsonc",
    "./modules/power.jsonc",
    "./modules/workspaces.jsonc",
    "./modules/audio.jsonc",
    "./modules/connections.jsonc",
    "./modules/battery.jsonc",
    "./modules/clock.jsonc",
    "./modules/tray.jsonc"
  ],

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [
    "clock",
    "group/distro-group",
    "group/storage",
    "group/system"
  ],
  "modules-right": [
    "tray",
    "power-profiles-daemon",
    "idle_inhibitor",
    "group/audio",
    "group/connections",
    "battery",
    "custom/power"
  ]
}
