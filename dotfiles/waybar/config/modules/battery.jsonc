{
  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}",
    "format-full": "{icon}",
    "format-charging": "<span size='12pt'>󱐌</span>",
    "format-plugged": "",
    "format-alt": "{icon}",
    "tooltip-format": "{timeTo}\nUsage: {power:0.1f} W\nHealth: {health}%\nCycles: {cycles}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "on-click": "~/.config/rofi/scripts/control-brightness",
  },
}
