{
  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}",
    "format-full": "{icon}",
    "format-charging": "<span size='12pt'>{icon}󱐌</span>",
    "format-plugged": "",
    "format-alt": "{icon}",
    "tooltip-format": "{timeTo}\nCharge: {capacity}%\nUsage: {power:0.1f} W",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    },
    "on-click": "~/.config/rofi/scripts/control-brightness",
  },
}
