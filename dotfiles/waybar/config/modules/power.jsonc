{
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Profile: {profile}\nDriver: {driver}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "󰶘",
      "power-saver": ""
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛨",
      "deactivated": "󰛩"
    },
    "tooltip-format-activated": "Idle inhibitor enabled",
    "tooltip-format-deactivated": "Idle inhibitor disabled"
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Power menu",
    "on-click": "~/.config/rofi/scripts/control-session"
  }
}
