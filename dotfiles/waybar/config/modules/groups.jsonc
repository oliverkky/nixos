{
  "group/distro-group": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": true,
    },
    "modules": [
      "custom/distro",
      "custom/terminal",
      "custom/files",
      "custom/obsidian",
      "custom/browser",
    ],
  },

  "group/storage": {
    "orientation": "horizontal",
    "modules": ["disk", "memory"],
  },

  "group/system": {
    "orientation": "horizontal",
    "modules": ["cpu", "temperature"],
  },

  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio/slider", "pulseaudio#microphone"],
  },

  "group/connections": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "network"],
  },
}
