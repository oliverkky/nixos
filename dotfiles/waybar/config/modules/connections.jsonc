{
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-linked": "󱘖",
    "format-disconnected": "󰤣",
    "format-disabled": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-disconnected": "No connection",
    "tooltip-format-disabled": "Wi-Fi is off",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\nFrequency: {frequency} GHz\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname} connected\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
    "tooltip-format-linked": "{ifname}: no IP address",
    "on-click": "~/.config/rofi/scripts/control-network",
    "on-click-right": "kitty -e nmtui",
    "on-scroll-up": "nmcli radio wifi on",
    "on-scroll-down": "nmcli radio wifi off"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "tooltip-format": "{controller_alias} {status}",
    "tooltip-format-connected": "{num_connections} connected:\n{device_enumerate}",
    "tooltip-format-connected-battery": "{num_connections} connected:\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "~/.config/rofi/scripts/control-bluetooth",
    "on-click-right": "~/.config/waybar/popup/toggle.sh quick-settings"
  }
}
